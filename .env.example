# PostgreSQL connection string supplied by your deployment provider.
# Keep the real value only in its encrypted environment-variable settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ai_resume_analyzer?sslmode=require

# Optional SMTP configuration for interview invitations.
ATS_SMTP_HOST=smtp.gmail.com
ATS_SMTP_PORT=587
ATS_SMTP_USER=your-email@example.com
ATS_SMTP_PASSWORD=your-app-password
ATS_SMTP_FROM_EMAIL=your-email@example.com
ATS_SMTP_FROM_NAME=Your Company Recruitment
