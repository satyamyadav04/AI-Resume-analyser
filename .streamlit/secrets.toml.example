# PostgreSQL connection string. Keep the real value in Streamlit Cloud's
# Advanced settings -> Secrets; never commit it to this repository.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/ai_resume_analyzer?sslmode=require"

[smtp]
host = "smtp.gmail.com"
port = 587
